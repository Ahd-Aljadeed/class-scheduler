# Normalize line endings. Text files are stored as LF in the repository and
# checked out with the platform's native endings, so a Windows and a macOS
# contributor no longer produce whole-file diffs for a one-line change.
* text=auto eol=lf

# Binary assets: never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pdf   binary
*.zip   binary

# Keep generated lockfiles out of diff review noise.
package-lock.json -diff
